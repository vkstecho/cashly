{
  "name": "Cashly by VKS Tech",
  "short_name": "Cashly",
  "description": "Personal finance tracker with budgets, SMS import, statements and tax tools",
  "start_url": "/app/index.html",
  "display": "standalone",
  "background_color": "#F4F6F9",
  "theme_color": "#16A34A",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/app/?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Add Expense",
      "short_name": "Expense",
      "url": "/app/?action=expense",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Add Income",
      "short_name": "Income",
      "url": "/app/?action=income",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "url": "/app/?action=reports",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "id": "/app/",
  "scope": "/app/"
}
