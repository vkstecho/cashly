{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "channelId",
    "handle",
    "channelName",
    "lastSuccessfulSync",
    "videos"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channelId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^UC[A-Za-z0-9_-]{22}$"
        }
      ]
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "channelName": {
      "type": "string",
      "minLength": 1
    },
    "lastSuccessfulSync": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/video"
      }
    },
    "lastContentChange": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "publishedAt",
        "thumbnail",
        "durationSeconds",
        "language",
        "contentType",
        "classificationSource",
        "embeddable",
        "watchUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "thumbnail": {
          "type": "string",
          "pattern": "^https://i\\.ytimg\\.com/"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "contentType": {
          "enum": [
            "short",
            "video",
            "unknown"
          ]
        },
        "classificationSource": {
          "enum": [
            "creator-override",
            "creator-playlist",
            "unknown"
          ]
        },
        "embeddable": {
          "type": "boolean"
        },
        "watchUrl": {
          "type": "string",
          "pattern": "^https://www\\.youtube\\.com/watch"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "enum": [
              "retire-today",
              "retirement",
              "sip",
              "emi",
              "inflation",
              "budget",
              "spends"
            ]
          }
        }
      }
    }
  }
}
