{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "channelId",
    "handle",
    "channelName",
    "lastSuccessfulSync",
    "videos"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channelId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^UC[A-Za-z0-9_-]{22}$"
        }
      ]
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "channelName": {
      "type": "string",
      "minLength": 1
    },
    "lastSuccessfulSync": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/video"
      }
    },
    "lastContentChange": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "identityVerifiedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastSuccessfulPublication": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "playlists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/playlist"
      }
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "publishedAt",
        "thumbnail",
        "durationSeconds",
        "language",
        "contentType",
        "classificationSource",
        "embeddable",
        "watchUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "thumbnail": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://(?:i[0-9]?\\.ytimg\\.com|img\\.youtube\\.com)/"
        },
        "durationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "contentType": {
          "enum": [
            "short",
            "video",
            "unknown"
          ]
        },
        "classificationSource": {
          "enum": [
            "creator-override",
            "creator-playlist",
            "unknown"
          ]
        },
        "embeddable": {
          "type": "boolean"
        },
        "watchUrl": {
          "type": "string",
          "pattern": "^https://www\\.youtube\\.com/watch"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "enum": [
              "retire-today",
              "retirement",
              "sip",
              "emi",
              "inflation",
              "budget",
              "spends"
            ]
          }
        },
        "channelId": {
          "type": "string",
          "pattern": "^UC[A-Za-z0-9_-]{22}$"
        },
        "channelTitle": {
          "type": "string",
          "minLength": 1
        },
        "categoryId": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "thumbnails": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^https://(?:i[0-9]?\\.ytimg\\.com|img\\.youtube\\.com)/"
          }
        },
        "availability": {
          "const": "public"
        },
        "liveStatus": {
          "enum": [
            "none",
            "live",
            "upcoming",
            "recorded"
          ]
        },
        "scheduledStartTime": {
          "type": "string",
          "format": "date-time"
        },
        "actualStartTime": {
          "type": "string",
          "format": "date-time"
        },
        "actualEndTime": {
          "type": "string",
          "format": "date-time"
        },
        "defaultLanguage": {
          "type": "string"
        },
        "defaultAudioLanguage": {
          "type": "string"
        },
        "playlistIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{2,128}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "liveStatus": {
                "enum": [
                  "live",
                  "upcoming"
                ]
              }
            },
            "required": [
              "liveStatus"
            ]
          },
          "else": {
            "properties": {
              "durationSeconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "playlist": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "thumbnail",
        "videoIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{2,128}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "thumbnail": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://(?:i[0-9]?\\.ytimg\\.com|img\\.youtube\\.com)/"
        },
        "videoCount": {
          "type": "integer",
          "minimum": 0
        },
        "videoIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          }
        }
      }
    }
  }
}
