rules_version = '2';
// Candidate for staging. Publish to production only after reviewing the active rules and approval.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function cashlyFields() {
        return ['data', 'updated', 'name', 'cashlyRevision', 'cashlySchema'];
      }

      function versionedWrite(previous) {
        let next = request.resource.data;
        return next.keys().hasAll(cashlyFields())
          && previous is int
          && previous >= 0
          && previous < 9007199254740991
          && next.cashlyRevision is int
          && next.cashlyRevision == previous + 1
          && next.cashlySchema is int
          && next.cashlySchema == 81
          && next.updated is int
          && next.updated >= 0
          && next.name is string
          && next.data is map
          && next.data.transactions is list;
      }

      allow get, delete: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(cashlyFields())
        && versionedWrite(0);
      allow update: if owner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(cashlyFields())
        && versionedWrite(resource.data.get('cashlyRevision', 0));
    }
  }
}
